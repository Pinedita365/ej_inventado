# =======================================================
# TriPing - Variables de Entorno (Entorno Local)
#
# INSTRUCCIONES:
#   1. Copia este fichero como .env  (cp .env.example .env)
#   2. Rellena los valores marcados como OBLIGATORIO
#   3. Arranca la base de datos:  docker-compose up -d
#   4. Ejecuta la app:            mvn spring-boot:run
#
# NUNCA subas el fichero .env a git (ya está en .gitignore)
# =======================================================

# -------------------------------------------------------
# Base de datos MySQL (docker-compose.yml)
# -------------------------------------------------------
DB_USERNAME=triping_user
DB_PASSWORD=triping_pass
MYSQL_ROOT_PASSWORD=root_secret_local

# -------------------------------------------------------
# OAuth2 - Google  [OBLIGATORIO para login con Google]
# Crear en: https://console.cloud.google.com
#   → APIs y servicios → Credenciales → ID de cliente OAuth 2.0
#   → Tipo: Aplicación web
#   → URI de redirección autorizado: http://localhost:8080/login/oauth2/code/google
# -------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------
# OAuth2 - GitHub  [OBLIGATORIO para login con GitHub]
# Crear en: https://github.com/settings/developers → OAuth Apps
#   → Homepage URL: http://localhost:8080
#   → Authorization callback URL: http://localhost:8080/login/oauth2/code/github
# -------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -------------------------------------------------------
# Cloudinary  [OBLIGATORIO para subir imágenes en el panel admin]
# Obtener en: https://cloudinary.com → Dashboard
# -------------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------------------
# Email - Gmail SMTP  [OBLIGATORIO para emails: 2FA, recuperación, itinerarios]
#
# GMAIL_USER    → tu dirección de Gmail (ej: tucuenta@gmail.com)
# GMAIL_APP_PASSWORD → Contraseña de aplicación de Google (NO tu contraseña normal)
#
# Cómo obtener la contraseña de aplicación:
#   1. Ve a https://myaccount.google.com/security
#   2. Activa la verificación en 2 pasos si no la tienes
#   3. Busca "Contraseñas de aplicación" (App passwords)
#   4. Crea una nueva → "Correo" + "Ordenador Windows" → Copiar la clave de 16 chars
# -------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# -------------------------------------------------------
# URL base de la aplicación (para links en emails)
# En local: http://localhost:8080  |  En producción: https://tudominio.com
# -------------------------------------------------------
APP_BASE_URL=http://localhost:8080
